# Copy this to deployment/.env and fill in values before running docker compose up

# Postgres
POSTGRES_USER=plutus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plutus_db

# FastAPI
ENVIRONMENT=prod
API_TOKEN=change-me-long-random-string
TOTAL_CAPITAL_INR=100000

# Data providers
PROVIDER_PRIMARY_OHLCV=yfinance

# Angel One (optional — enables live price + intraday charts)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI summaries (OpenRouter) — powers the homepage AI widgets.
# Leave OPENROUTER_API_KEY blank to disable.
OPENROUTER_API_KEY=
# OpenRouter model slug for summaries, e.g. deepseek/deepseek-v4-flash
LLM_MODEL=deepseek/deepseek-v4-flash
# Marketaux free news API (per-ticker sentiment for signal stocks). Blank = no news section.
MARKETAUX_API_KEY=

# Scheduler (IST hours)
SUNDAY_FULL_RUN_HOUR_IST=19
MONDAY_REVALIDATION_HOUR_IST=9
MONDAY_REVALIDATION_MINUTE_IST=10

# Frontend port (default: 80)
FRONTEND_PORT=80
