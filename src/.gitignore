# Plutus — gitignore
# Code root: src/

# Secrets — NEVER commit
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual env
.venv/
venv/

# Data caches (runtime-generated)
plutus/data/.cache/
plutus/data/fno_ban_list.txt

# Reports (system-generated; user can `git init` reports/ separately if they want history)
reports/weekly/

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Backtrader artifacts
*.png
strategy_*.csv
