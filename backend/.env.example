# ── Runtime ──────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────
# Dev: use local postgres or sqlite (sqlite not allowed in prod)
DB_URL=postgresql+psycopg://plutus:plutus@localhost:5432/plutus_db

# ── API auth ─────────────────────────────────────────────
# Single-operator bearer token. React login screen verifies this.
API_TOKEN=change-me-before-deploying

# ── Portfolio ─────────────────────────────────────────────
TOTAL_CAPITAL_INR=100000

# ── Data providers ───────────────────────────────────────
PROVIDER_PRIMARY_OHLCV=yfinance
PROVIDER_FALLBACK_OHLCV=nse
CACHE_TTL_OHLCV_HOURS=6

# ── Angel One SmartAPI (optional — enables live price & intraday) ──
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Notifications ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI summaries (OpenRouter) ────────────────────────────
# Powers the "This Week's Pipeline" and "Holdings Check-In" homepage widgets.
# Leave OPENROUTER_API_KEY blank to disable (widgets show a "configure" note).
OPENROUTER_API_KEY=
# OpenRouter model slug. Set to your DeepSeek model, e.g. deepseek/deepseek-v4-flash
LLM_MODEL=deepseek/deepseek-v4-flash
# Marketaux free news API (per-ticker sentiment for signal stocks). Blank = no news section.
MARKETAUX_API_KEY=

# ── Scheduler ────────────────────────────────────────────
SUNDAY_FULL_RUN_HOUR_IST=19
MONDAY_REVALIDATION_HOUR_IST=9
MONDAY_REVALIDATION_MINUTE_IST=10
MIDWEEK_MINI_SCREEN_ENABLED=false
